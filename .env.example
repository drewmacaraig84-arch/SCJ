# ==============================================================
# SCHOOL OF CRIMINAL JUSTICE EDUCATION (SCJE) INFORMATION SYSTEM
# Environment Template
# ==============================================================

APP_NAME="School of Criminal Justice Information System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=scje_secure_session_key_2026_crim_justice

# Database Configuration ('mysql' or 'sqlite')
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scj_db
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback path
DB_SQLITE_PATH=database/scj.sqlite

# Default Administrator Seed Credentials
DEFAULT_ADMIN_ID=ADMIN-001
DEFAULT_ADMIN_PASSWORD=password123
DEFAULT_ADMIN_NAME="Dean Office Admin"
DEFAULT_ADMIN_EMAIL=admin@dwcc-scje.edu.ph

# Security & Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15
SESSION_LIFETIME_HOURS=8
